# ==============================================================================
# DZF-ILAS (Dzuels Integrated Library & Administrative System)
# Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env or .env.local and fill in the actual values.
# NEVER commit credentials, private keys, or API secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base Application URL
BASEURL=http://localhost:3000

# Database Configuration (MongoDB Atlas or self-hosted)
# Used in production by connectDB() in src/lib/db.ts
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dzuelsDB?retryWrites=true&w=majority
# Local fallback (optional):
# MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/dzuelsDB

# Staff Authentication & JWT Configuration
# Used by signToken() and verifyToken() in src/lib/auth/jwt.ts
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=2d

# Cloudinary Storage (Patron webcam identity photos & book covers)
# Used in src/app/api/upload/patron-photo and src/app/api/upload/book-cover
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Service Account (Cohort 2-Way Sheet Synchronization)
# Used in src/lib/cohorts/googleSheets.ts
# Optional if Google Sheets synchronization is not enabled
GOOGLE_CLIENT_EMAIL=dzf-cohort-sync@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_SHEET_ID=your_google_spreadsheet_id
